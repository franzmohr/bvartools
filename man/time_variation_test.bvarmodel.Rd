# The non-centred prior on the coefficients and the log-volatilities
model <- add_priors(model,
                    coef = list(v_i = 1 / 10, omega_v = 0.001),
                    sigma = list(mu = 0, v_i = 1 / 100, omega_v = 0.1,
                                 state_variance = 0.05, offset = 1e-4))
